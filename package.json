{
  "name": "jolanda-discord-bot",
  "version": "1.0.0",
  "description": "A privacy-conscious, web-enabled Discord assistant powered by OpenRouter.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && eslint . && vitest run --coverage",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/require-openrouter-live-key.mjs && OPENROUTER_LIVE_TESTS=true vitest run tests/openrouter.live.test.ts",
    "test:release-live": "node scripts/require-openrouter-live-key.mjs && OPENROUTER_LIVE_TESTS=true OPENROUTER_LIVE_WEB_TESTS=true OPENROUTER_LIVE_REDTEAM_TESTS=true OPENROUTER_LIVE_REASONING_TESTS=true vitest run tests/openrouter.live.test.ts",
    "test:reels-smoke": "pnpm build && node scripts/reels-smoke.mjs"
  },
  "keywords": [
    "discord",
    "openrouter",
    "mongodb"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ipaddr.js": "^2.5.0",
    "linkify-it": "^6.1.0",
    "mongodb": "^7.5.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
