NODE_ENV=production
LOG_LEVEL=info
# Generate with: openssl rand -base64 32
DATA_PROTECTION_SECRET=

DISCORD_TOKEN=
# IANA time zone used for Jolanda's trusted turn clock and relative dates.
JOLANDA_TIME_ZONE=Europe/Bratislava

OPENROUTER_API_KEY=
# Optional attribution URL sent to OpenRouter.
OPENROUTER_APP_URL=

# Paste the Atlas SRV URI issued for Jolanda's least-privilege database user.
MONGODB_URI=
MONGODB_DB_NAME=jolanda

# Each limit must cover one worst-case turn (~$1.21 at the largest model and reasoning effort);
# startup fails with the exact required figure otherwise.
DAILY_SPEND_LIMIT_USD=2
MONTHLY_SPEND_LIMIT_USD=10
PROMPTS_PER_MINUTE=3
MAX_CONCURRENT_TURNS=2

MAX_CONTEXT_MESSAGES=50
MAX_PROMPT_CHARACTERS=32000
TRANSCRIPT_TTL_DAYS=7

# Reels covers Instagram and TikTok; also requires /jolanda reels enabled:true per channel.
INSTAGRAM_REELS_ENABLED=false
INSTAGRAM_YT_DLP_PATH=/opt/yt-dlp/bin/yt-dlp
INSTAGRAM_FFPROBE_PATH=/usr/bin/ffprobe
INSTAGRAM_FFMPEG_PATH=/usr/bin/ffmpeg
INSTAGRAM_REELS_MAX_BYTES=20971520
INSTAGRAM_REELS_JOB_TIMEOUT_MS=240000
